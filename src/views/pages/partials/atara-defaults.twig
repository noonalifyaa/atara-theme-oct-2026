{# Merchant-provided nav (collection: title · url · children "name|url, name|url") overrides the default #}
{% set _nav_setting = theme.settings.get('atara_nav') %}
{% set _nav = [] %}
{% if _nav_setting is iterable and _nav_setting|length > 0 %}
  {% for row in _nav_setting %}
    {% if row['atara_nav.title'] %}
      {% set _children = [] %}
      {% for pair in (row['atara_nav.children'] ?: '')|split(',') %}
        {% set p = pair|trim|split('|') %}
        {% if p[0] %}{% set _children = _children|merge([{'title': p[0]|trim, 'url': (p[1] ?? '#')|trim}]) %}{% endif %}
      {% endfor %}
      {% set _nav = _nav|merge([{'title': row['atara_nav.title'], 'url': row['atara_nav.url'] ?: '#', 'children': _children}]) %}
    {% endif %}
  {% endfor %}
{% endif %}
{% if _nav|length == 0 %}{% set _nav = _nav_default %}{% endif %}
{{ theme.settings.set('at_nav', _nav) }}

